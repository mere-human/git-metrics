{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after_python_edit.py",
        "matcher": "Write|TabWrite"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block_destructive_git.py",
        "matcher": "git ",
        "failClosed": false
      }
    ]
  }
}
