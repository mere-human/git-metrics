{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-python-edit.sh",
        "matcher": "Write|TabWrite"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-destructive-git.sh",
        "matcher": "git ",
        "failClosed": false
      }
    ]
  }
}
